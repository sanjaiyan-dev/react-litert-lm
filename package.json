{
  "name": "react-litert-lm",
  "version": "2.0.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tanstack": {
      "types": "./dist/tanstack/index.d.ts",
      "import": "./dist/tanstack/index.mjs",
      "require": "./dist/tanstack/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "format": "biome format ./src --write",
    "lint": "biome lint ./src",
    "docs": "typedoc",
    "deploy": "npm run docs && gh-pages -d docs",
    "prepublishOnly": "npm run format && npm run lint && npm run build && npm run docs",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "Sanjaiyan.P",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "2.4.16",
    "@litert-lm/core": "^0.13.1",
    "@tanstack/react-query": "^5.101.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.3.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@litert-lm/core": "^0.12.0",
